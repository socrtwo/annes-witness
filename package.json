{
  "name": "annes-witness",
  "version": "0.1.0",
  "private": true,
  "description": "Anne's Witness: an original open-source evidence workbench that ties every claim in your work to the exact spot in a source that backs it, checks that they still agree, and prints the proof. Part of the Anne's Office suite. Planning stage.",
  "keywords": [
    "annes-witness",
    "annes-office-suite",
    "evidence",
    "evidence-analysis",
    "fact-checking",
    "claim-verification",
    "source-verification",
    "provenance",
    "audit-trail",
    "tie-out",
    "citations",
    "genealogy",
    "transcription",
    "collation",
    "ocr",
    "grounded-ai",
    "ai-assistant",
    "office-suite",
    "offline",
    "clean-room"
  ],
  "license": "MIT",
  "author": {
    "name": "Paul D Pruitt"
  },
  "homepage": "https://github.com/socrtwo/annes-witness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/socrtwo/annes-witness.git"
  },
  "bugs": {
    "url": "https://github.com/socrtwo/annes-witness/issues"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "plan": "python3 scripts/gen-plan.py",
    "validate": "python3 scripts/gen-plan.py --check",
    "catalog": "vite-node scripts/gen-catalog.ts",
    "witness": "vite-node scripts/witness-cli.ts --",
    "desktop": "npm run build && npx electron electron/main.cjs",
    "desktop:dist": "npm run build && npx electron-builder --config electron-builder.config.cjs",
    "cap:sync": "npm run build && npx cap sync",
    "e2e": "node tests/e2e/smoke.mjs",
    "prebuild": "node scripts/gen-notices.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "jszip": "^3.10.2",
    "material-symbols": "^0.49.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "sql.js": "^1.16.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sql.js": "^1.4.11",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "main": "electron/main.cjs"
}
