{
  "name": "Anne's Witness",
  "short_name": "Witness",
  "description": "Tie every claim in your work to the exact spot in a source that backs it.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#9C6B0E",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/x-annes-witness": [".witness"] } }]
}
